# Konfigurasi Topik MQTT (Status dari PLC)
TOPIC_STATUS_MODE=inianggrek/control/modeout
TOPIC_STATUS_SPRAY=inianggrek/control/outspray
TOPIC_STATUS_MURNI=inianggrek/control/outmurni
TOPIC_STATUS_NUTRISI=inianggrek/control/outnutrisi
TOPIC_STATUS_EXHAUST=inianggrek/control/outexhaust

# Konfigurasi Topik MQTT (Receipt/Tanda Terima)
TOPIC_RECEIPT_MODE=inianggrek/control
TOPIC_RECEIPT_SPRAY=inianggrek/control/spraystatus
TOPIC_RECEIPT_MURNI=inianggrek/control/murnistatus
TOPIC_RECEIPT_NUTRISI=inianggrek/control/nutrisistatus
TOPIC_RECEIPT_EXHAUST=inianggrek/control/exhauststatus

# Konfigurasi Topik MQTT (Data Sensor dari PLC -> Web)
TOPIC_TELEMETRY=esp32/dht11/telemetry
TOPIC_SOIL=inianggrek/soil
TOPIC_TDS=inianggrek/tds
TOPIC_PYRA=inianggrek/pyra
TOPIC_THPR=inianggrek/thpr

# Konfigurasi Topik MQTT (Kontrol Aktuator dari Web -> PLC)
TOPIC_CONTROL_MODE=inianggrek/control/mode
TOPIC_CONTROL_SPRAY=inianggrek/control/spray
TOPIC_CONTROL_MURNI=inianggrek/control/murni
TOPIC_CONTROL_NUTRISI=inianggrek/control/nutrisi
TOPIC_CONTROL_EXHAUST=inianggrek/control/exhaust
TOPIC_THRESHOLDS=inianggrek/thresholds
